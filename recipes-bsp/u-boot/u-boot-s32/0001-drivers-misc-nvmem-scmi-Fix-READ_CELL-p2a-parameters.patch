From 6152744d1954fb8f4250226b29667a8e76fae45e Mon Sep 17 00:00:00 2001
From: Andrei Cherechesu <andrei.cherechesu@nxp.com>
Date: Mon, 12 Feb 2024 17:00:17 +0200
Subject: [PATCH] drivers/misc: nvmem-scmi: Fix READ_CELL p2a parameters order

Fixed the order of the READ_CELL p2a parameters to fit the
NVMEM SCMI protocol specification.

Issue: ALB-11077
Signed-off-by: Andrei Cherechesu <andrei.cherechesu@nxp.com>
---
 drivers/misc/nvmem-scmi.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/misc/nvmem-scmi.c b/drivers/misc/nvmem-scmi.c
index 7bd1e430f1..e567b7764f 100644
--- a/drivers/misc/nvmem-scmi.c
+++ b/drivers/misc/nvmem-scmi.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0+ OR BSD-3-Clause
 /*
- * Copyright 2023 NXP
+ * Copyright 2023-2024 NXP
  */
 
 #include <dm.h>
@@ -25,8 +25,8 @@ static int scmi_nvmem_read(struct udevice *dev, int offset,
 {
 	struct {
 		s32 status;
-		u32 value;
 		u32 bytes_read;
+		u32 value;
 	} response;
 	struct {
 		u32 offset;
-- 
2.25.1

