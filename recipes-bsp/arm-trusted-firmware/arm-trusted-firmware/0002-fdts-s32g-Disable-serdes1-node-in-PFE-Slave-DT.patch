From b8a90ce4a62f35bdb7325ad2b64e7dcc1f09c73e Mon Sep 17 00:00:00 2001
From: George Mocanu <george.mocanu@nxp.com>
Date: Fri, 6 Dec 2024 14:15:46 +0200
Subject: [PATCH] fdts: s32g: Disable serdes1 node in PFE Slave DT

Serdes1 is managed/configured by the real-time applications
when the Linux domain acts as the PFE Slave.

Signed-off-by: George Mocanu <george.mocanu@nxp.com>
---
 fdts/s32g-goldvip-pfe-slave.dtsi | 8 ++++++++
 fdts/s32g274a-rdb2-pfems.dts     | 1 +
 fdts/s32g399a-rdb3-pfems.dts     | 1 +
 3 files changed, 10 insertions(+)
 create mode 100644 fdts/s32g-goldvip-pfe-slave.dtsi

diff --git a/fdts/s32g-goldvip-pfe-slave.dtsi b/fdts/s32g-goldvip-pfe-slave.dtsi
new file mode 100644
index 000000000..3367643fc
--- /dev/null
+++ b/fdts/s32g-goldvip-pfe-slave.dtsi
@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * Copyright 2024 NXP
+ */
+
+&serdes1 {
+	status = "disabled";
+};
diff --git a/fdts/s32g274a-rdb2-pfems.dts b/fdts/s32g274a-rdb2-pfems.dts
index c54df5dd7..72f7d0c2e 100644
--- a/fdts/s32g274a-rdb2-pfems.dts
+++ b/fdts/s32g274a-rdb2-pfems.dts
@@ -8,6 +8,7 @@
 #include "s32g-pfe-slave.dtsi"
 #include "s32g2.dtsi"
 #include "s32gxxxa-rdb.dtsi"
+#include "s32g-goldvip-pfe-slave.dtsi"
 
 / {
 	aliases {
diff --git a/fdts/s32g399a-rdb3-pfems.dts b/fdts/s32g399a-rdb3-pfems.dts
index 9af566b16..cb89e8340 100644
--- a/fdts/s32g399a-rdb3-pfems.dts
+++ b/fdts/s32g399a-rdb3-pfems.dts
@@ -8,6 +8,7 @@
 #include "s32g-pfe-slave.dtsi"
 #include "s32g3.dtsi"
 #include "s32gxxxa-rdb.dtsi"
+#include "s32g-goldvip-pfe-slave.dtsi"
 
 / {
 	aliases {
